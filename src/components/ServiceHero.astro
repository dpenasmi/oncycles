---
import { Image } from 'astro:assets';
import type { ServiceHeroData } from '../types/content';
export interface Props {
  headingId: string;
  hero: ServiceHeroData;
}
const { headingId, hero } = Astro.props;
const imageSource =
  typeof hero.image === 'string'
    ? { src: hero.image, width: hero.width, height: hero.height }
    : { src: hero.image };
const responsiveWidths = [768, 1280, 1672].filter(
  (width) => typeof hero.image === 'string' || width <= hero.image.width,
);
---

<section class="oc-services-hero" id="inicio" aria-labelledby={headingId}>
  <Image
    class="oc-services-hero__image"
    {...imageSource}
    alt={hero.alt}
    widths={responsiveWidths}
    sizes="100vw"
    format="webp"
    quality={90}
    loading="eager"
    fetchpriority="high"
  />
  <div class="oc-services-container oc-services-hero__content">
    <h1 class="oc-services-eyebrow" id={headingId}>
      {hero.eyebrow}
    </h1>
    <p class="oc-services-hero__title">
      {hero.line1}
      <br />
      <span>{hero.line2}</span>
    </p>
    <p class="oc-services-hero__intro">{hero.intro}</p>
    <div class="oc-services-actions">
      <a class="button" href="#reserva" data-booking-service={hero.service}>
        Solicita tu cita <span aria-hidden="true">↗</span>
      </a>
      <a class="button button-white" href={hero.exploreHref}>
        {hero.exploreLabel} <span aria-hidden="true">{hero.exploreIcon}</span>
      </a>
    </div>
    <p class="oc-services-hero__signature">{hero.signature}</p>
  </div>
</section>
