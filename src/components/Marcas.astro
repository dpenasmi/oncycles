---
import '../styles/marcas.css';
import { brands } from '../data/brands.js';
import { image } from '../data/images.js';
---

<section data-oc-marcas class="oc-marcas-loop" aria-labelledby="oc-marcas-loop-titulo">
  <div data-oc-marcas class="oc-marcas-loop__container">
    <div data-oc-marcas class="oc-marcas-loop__cabecera">
      <h2 data-oc-marcas id="oc-marcas-loop-titulo">
        Trabajo con estas marcas
      </h2>
    </div>
    <div
      data-oc-marcas
      class="oc-marcas-loop__ventana"
      tabindex="0"
      aria-label="Marcas con las que trabajo"
    >
      <div data-oc-marcas class="oc-marcas-loop__pista">
        <ul data-oc-marcas class="oc-marcas-loop__grupo" role="list">
          {brands.map((brand) => (
            <li data-oc-marcas>
              <img
                data-oc-marcas
                class={brand.white ? 'oc-marcas__logo-blanco' : undefined}
                src={image(brand.image)}
                alt={brand.name}
                width={brand.width}
                height={brand.height}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
        <!-- Copia visual para cerrar el bucle; no se anuncia dos veces. -->
        <ul
          data-oc-marcas
          class="oc-marcas-loop__grupo oc-marcas-loop__copia"
          role="list"
          aria-hidden="true"
        >
          {brands.map((brand) => (
            <li data-oc-marcas>
              <img
                data-oc-marcas
                class={brand.white ? 'oc-marcas__logo-blanco' : undefined}
                src={image(brand.image)}
                alt={brand.name}
                width={brand.width}
                height={brand.height}
                loading="eager"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
