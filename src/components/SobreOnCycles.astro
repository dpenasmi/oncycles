---
import '../styles/sobre-oncycles.css';
import { siteImages } from '../data/images.js';
interface Props {
  image?: string;
  workshopHref?: string;
}

const { image = siteImages.portrait, workshopHref = '#taller' } = Astro.props;
---

<section data-oc-sobre-oncycles id="oficio" class="oc-about" aria-labelledby="oc-about-title">
  <div data-oc-sobre-oncycles class="oc-about__layout">
    <figure data-oc-sobre-oncycles class="oc-about__portrait">
      <span data-oc-sobre-oncycles class="oc-about__year" aria-hidden="true">
        2006
      </span>
      <img
        data-oc-sobre-oncycles
        class="oc-about__illustration"
        src={image}
        alt="Ilustración de un mecánico de On Cycles con una llave de taller"
        width="1243"
        height="1265"
        loading="lazy"
        decoding="async"
      />
      <figcaption data-oc-sobre-oncycles class="oc-about__caption">
        Desde 2006 · Barcelona
      </figcaption>
    </figure>

    <div data-oc-sobre-oncycles class="oc-about__content">
      <h2 data-oc-sobre-oncycles id="oc-about-title" class="oc-about__eyebrow oc-section-heading">
        Sobre On Cycles
      </h2>
      <p data-oc-sobre-oncycles class="oc-about__title">
        <span data-oc-sobre-oncycles>Un taller</span>
        <span data-oc-sobre-oncycles>con mucho</span>
        <span data-oc-sobre-oncycles class="oc-about__accent">
          oficio.
        </span>
      </p>
      <p data-oc-sobre-oncycles class="oc-about__description">
        Experiencia, tecnología y atención cercana desde 2006. Reviso tu bici, te explico lo que
        necesita y cuido cada ajuste para que vuelvas a disfrutar.
      </p>

      <div
        data-oc-sobre-oncycles
        class="oc-about__certifications"
        aria-labelledby="oc-about-certifications"
      >
        <h3
          data-oc-sobre-oncycles
          id="oc-about-certifications"
          class="oc-about__certification-label"
        >
          Servicio técnico certificado
        </h3>
        <div data-oc-sobre-oncycles class="oc-about__brands">
          <div data-oc-sobre-oncycles class="oc-about__brand oc-about__brand--ohlins">
            <img
              data-oc-sobre-oncycles
              src={siteImages.ohlins}
              alt="Öhlins"
              width="500"
              height="500"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div data-oc-sobre-oncycles class="oc-about__brand oc-about__brand--bosch">
            <img
              data-oc-sobre-oncycles
              src={siteImages.bosch}
              alt="Bosch"
              width="500"
              height="500"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <a data-oc-sobre-oncycles class="oc-about__link" href={workshopHref}>
        Conoce el taller{' '}
        <span data-oc-sobre-oncycles aria-hidden="true">
          ↗
        </span>
      </a>
    </div>
  </div>
</section>
