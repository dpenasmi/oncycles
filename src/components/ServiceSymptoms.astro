---
interface Props {
  headingId: string;
  eyebrow: string;
  title: string;
  accent: string;
  symptoms: string[];
  backgroundText?: string;
}

const { headingId, eyebrow, title, accent, symptoms, backgroundText } = Astro.props;
---

<section
  class="oc-services-container oc-services-section oc-service-symptoms"
  aria-labelledby={headingId}
>
  {backgroundText && (
    <span class="oc-service-symptoms__background" aria-hidden="true">
      {backgroundText}
    </span>
  )}
  <div>
    <p class="oc-services-eyebrow">{eyebrow}</p>
    <h2 class="oc-services-display" id={headingId}>
      {title}
      <br />
      <span>{accent}</span>
    </h2>
  </div>
  <ol class="oc-service-symptoms__list">
    {symptoms.map((symptom, index) => (
      <li>
        <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        {symptom}
      </li>
    ))}
  </ol>
</section>

<style>
  .oc-service-symptoms {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 48px;
    border-bottom: 1px solid var(--services-line);
    overflow: hidden;
    isolation: isolate;
  }
  .oc-service-symptoms__background {
    position: absolute;
    z-index: 0;
    right: var(--services-gutter);
    bottom: 0;
    width: max-content;
    color: #202020;
    font-family: var(--oc-font-display, 'Archivo Black', Arial, sans-serif);
    font-size: clamp(36px, 9.5vw, 200px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.055em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }
  .oc-service-symptoms > div,
  .oc-service-symptoms__list {
    position: relative;
    z-index: 1;
  }
  .oc-service-symptoms__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 24px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .oc-service-symptoms__list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--services-line);
    font-size: 15px;
    font-weight: 700;
  }
  .oc-service-symptoms__list li span {
    color: var(--services-accent);
    font-weight: 800;
  }
  @media (max-width: 1024px) {
    .oc-service-symptoms {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  @media (max-width: 700px) {
    .oc-service-symptoms__list {
      grid-template-columns: 1fr;
    }
  }
</style>
