---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import Workflow from '../components/Workflow.astro';
import ServiceSymptoms from '../components/ServiceSymptoms.astro';
import { Image } from 'astro:assets';
import { base, withBase } from '../lib/paths.js';
import { siteImages } from '../data/images';
import {
  ebikePage,
  ebikeHero,
  ebikeSpecialties,
  ebikeWorkflow,
  ebikeBrands,
  ebikeFaqs,
} from '../data/ebike';
import '../styles/ebike.css';
---

<ServiceLayout
  page={ebikePage}
  hero={ebikeHero}
  headingId="ebike-h1"
  bodyClass="oc-services-page oc-ebike-page"
  certificates={[{ name: 'Bosch', src: siteImages.bosch }]}
  faqs={ebikeFaqs}
  faqHeadingId="ebike-faq-title"
  defaultService="E-Bike"
>
  <div class="oc-ebike-content-track">
    <div class="oc-ebike-content-track__watermark" aria-hidden="true">
      <span>E-BIKE</span>
    </div>
    <nav class="oc-services-container oc-ebike-breadcrumb" aria-label="Ruta de navegación">
      <ol>
        <li>
          <a href={base}>Inicio</a>
        </li>
        <li>
          <a href={withBase('reparacion-bicicletas-barcelona/')}>Servicios</a>
        </li>
        <li>
          <span aria-current="page">E-Bike</span>
        </li>
      </ol>
    </nav>

    <ServiceSymptoms
      headingId="ebike-symptoms-title"
      eyebrow="Señales de aviso"
      title="¿Tu e-bike"
      accent="te está avisando?"
      symptoms={[
        'La asistencia se corta o responde de forma irregular',
        'La autonomía ha bajado sin un motivo claro',
        'Aparece un aviso o código de error en la pantalla',
        'Notas ruidos o vibraciones al activar la asistencia',
      ]}
    />

    <section
      class="oc-services-container oc-services-section oc-ebike-intro"
      aria-labelledby="ebike-intro-title"
    >
      <div>
        <p class="oc-services-eyebrow">Tecnología y mecánica</p>
        <h2 class="oc-services-display" id="ebike-intro-title">
          Más tecnología.
          <br />
          <span>El mismo cuidado.</span>
        </h2>
      </div>
      <div class="oc-ebike-intro__text">
        <p>
          Reviso tu e-bike, te explico qué necesita y acuerdo contigo el trabajo antes de
          intervenir.
        </p>
        <ul class="oc-ebike-benefits" role="list">
          <li>Diagnóstico</li>
          <li>Precisión</li>
          <li>Confianza</li>
        </ul>
      </div>
    </section>

    <section
      class="oc-services-container oc-services-section oc-ebike-specialties"
      id="cuidado-ebike"
      aria-labelledby="ebike-specialties-title"
    >
      <p class="oc-services-eyebrow">Cuidado para cada sistema</p>
      <h2 class="oc-services-display" id="ebike-specialties-title">
        Tu e-bike. <span>Al detalle.</span>
      </h2>
      <div class="oc-ebike-grid">
        {ebikeSpecialties.map((item, index) => (
          <article class="oc-ebike-card">
            <div class="oc-ebike-card__photo">
              <Image
                src={item.image}
                alt={item.alt}
                widths={[480, 800, 1200]}
                sizes="(max-width: 700px) 92vw, (max-width: 1024px) 46vw, 560px"
                format="webp"
                quality={90}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="oc-ebike-card__body">
              <h3>
                <a
                  href="#reserva"
                  data-booking-service={item.service}
                  data-booking-detail={`E-Bike · ${item.title}`}
                >
                  <span class="oc-ebike-card__number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span>{item.title}</span>
                  <span class="oc-ebike-card__arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="oc-ebike-cta">
        <a class="button" href="#reserva" data-booking-service="E-Bike">
          Consulta tu e-bike <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <Workflow headingId="ebike-workflow-title" line1="Un proceso técnico." steps={ebikeWorkflow} />

    <section
      class="oc-services-container oc-services-section oc-ebike-brands"
      aria-labelledby="ebike-brands-title"
    >
      <p class="oc-services-eyebrow">Principales marcas</p>
      <div class="oc-ebike-brands__heading">
        <h2 class="oc-services-display" id="ebike-brands-title">
          Experiencia <span>con tu e-bike.</span>
        </h2>
        <p>Consulta el servicio disponible para tu marca, sistema y modelo.</p>
      </div>
      <ul class="oc-ebike-brands__list" role="list">
        {ebikeBrands.map((brand) => (
          <li>
            {brand.image ? (
              <img
                class:list={[
                  'oc-ebike-brand',
                  { 'oc-ebike-brand--inverted': brand.presentation === 'dark-on-light' },
                ]}
                src={brand.image}
                alt={brand.name}
                width="400"
                height="140"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span
                class:list={[
                  'oc-ebike-wordmark',
                  { 'oc-ebike-wordmark--brose': brand.name === 'Brose' },
                ]}
              >
                {brand.name === 'Brose' ? 'brose' : brand.name}
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  </div>
</ServiceLayout>

<style>
  .oc-ebike-content-track {
    --ebike-watermark-size: clamp(36px, 9.5vw, 200px);
    position: relative;
    isolation: isolate;
  }
  .oc-ebike-content-track__watermark {
    position: sticky;
    top: 45svh;
    height: var(--ebike-watermark-size);
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }
  .oc-ebike-content-track__watermark span {
    position: absolute;
    top: 0;
    right: var(--services-gutter);
    color: #202020;
    font-family: var(--oc-font-display, 'Archivo Black', Arial, sans-serif);
    font-size: var(--ebike-watermark-size);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  :global(.oc-ebike-content-track > :not(.oc-ebike-content-track__watermark)) {
    position: relative;
    z-index: 1;
  }
  .oc-ebike-breadcrumb {
    margin-top: calc(0px - var(--ebike-watermark-size));
    padding-block: 24px 0;
  }
  .oc-ebike-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .oc-ebike-breadcrumb li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #bdbdbd;
    font-size: 12px;
    line-height: 1.5;
  }
  .oc-ebike-breadcrumb li + li::before {
    content: '/';
    color: #666;
  }
  .oc-ebike-breadcrumb a {
    color: inherit;
  }
  .oc-ebike-breadcrumb a:hover,
  .oc-ebike-breadcrumb [aria-current] {
    color: var(--services-accent);
  }
  .oc-ebike-intro {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 56px;
  }
  .oc-ebike-intro__text {
    min-width: 0;
    padding-left: 48px;
    border-left: 1px solid var(--services-line);
  }
  .oc-ebike-intro__text > p {
    margin: 0;
    color: var(--services-text);
    font-size: 18px;
    line-height: 1.65;
  }
  .oc-ebike-benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
  }
  .oc-ebike-benefits li {
    display: flex;
    align-items: center;
    gap: 10px;
    font:
      800 12px/1.5 Arial,
      sans-serif;
    text-transform: uppercase;
  }
  .oc-ebike-benefits li::before {
    content: '✓';
    font-size: 20px;
    color: var(--services-accent);
  }
  .oc-ebike-specialties {
    border-top: 1px solid var(--services-line);
  }
  .oc-ebike-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
  }
  .oc-ebike-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    position: relative;
    isolation: isolate;
    background: #101010;
    border: 1px solid var(--services-line);
  }
  .oc-ebike-card__photo {
    overflow: hidden;
  }
  .oc-ebike-card__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    transition:
      transform 800ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .oc-ebike-card__body {
    flex: 1;
    padding: 22px;
  }
  .oc-ebike-card h3 {
    margin: 0;
    font:
      800 22px/1.25 Arial,
      sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.025em;
  }
  .oc-ebike-card h3 a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 10px;
    color: #fff;
  }
  .oc-ebike-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .oc-ebike-card__number,
  .oc-ebike-card__arrow {
    color: var(--services-accent);
  }
  .oc-ebike-card__arrow {
    font:
      400 26px/1 Arial,
      sans-serif;
  }
  .oc-ebike-card p {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--services-text);
  }
  .oc-ebike-card a:hover {
    color: var(--services-accent);
  }
  .oc-ebike-cta {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }
  .oc-ebike-brands {
    border-block: 1px solid var(--services-line);
  }
  .oc-ebike-brands__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
  }
  .oc-ebike-brands__heading > p {
    max-width: 360px;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--services-text);
  }
  .oc-ebike-brands__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
  }
  .oc-ebike-brands__list li {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .oc-ebike-brands__list li + li {
    border-left: 1px solid var(--services-line);
  }
  .oc-ebike-brands__list img {
    display: block;
    width: min(100%, 180px);
    height: 75px;
    object-fit: contain;
  }
  .oc-ebike-brand {
    filter: brightness(0) invert(1);
  }
  .oc-ebike-brand--inverted {
    filter: grayscale(1) invert(1) brightness(1.8);
    mix-blend-mode: screen;
  }
  .oc-ebike-wordmark {
    color: #fff;
    font:
      900 clamp(24px, 3vw, 40px)/1.1 Arial,
      sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.04em;
  }
  .oc-ebike-wordmark--brose {
    text-transform: none;
    font-style: italic;
    letter-spacing: -0.06em;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .oc-ebike-card:hover .oc-ebike-card__photo :global(img),
    .oc-ebike-card:focus-within .oc-ebike-card__photo :global(img) {
      transform: scale(1.035);
      filter: brightness(1.06);
    }
  }
  @media (max-width: 1024px) {
    .oc-ebike-intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .oc-ebike-intro__text {
      padding-left: 0;
      border-left: 0;
    }
    .oc-ebike-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
    .oc-ebike-brands__heading {
      display: block;
    }
    .oc-ebike-brands__heading > p {
      max-width: none;
      margin-top: 24px;
    }
  }
  @media (max-width: 700px) {
    .oc-ebike-intro {
      gap: 24px;
    }
    .oc-ebike-intro__text > p {
      font-size: 16px;
    }
    .oc-ebike-benefits {
      gap: 12px 18px;
    }
    .oc-ebike-grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 28px;
      gap: 24px;
    }
    .oc-ebike-card h3 {
      font-size: 20px;
    }
    .oc-ebike-brands__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .oc-ebike-brands__list li {
      padding: 14px;
    }
    .oc-ebike-brands__list li:nth-child(odd) {
      border-left: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .oc-ebike-card__photo :global(img) {
      transition: none;
      transform: none;
      filter: none;
    }
  }
</style>
