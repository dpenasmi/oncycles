---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import { base, withBase } from '../lib/paths.js';
import { Image } from 'astro:assets';
import Workflow from '../components/Workflow.astro';
import ServiceSymptoms from '../components/ServiceSymptoms.astro';
import ServiceWatermarkTrack from '../components/ServiceWatermarkTrack.astro';
import {
  suspensionPage,
  suspensionHero,
  specialties,
  brands,
  faqs,
  workflowSteps,
} from '../data/suspension.ts';
import { siteImages } from '../data/images.ts';
import '../styles/suspension-bicicleta.css';
---

<ServiceLayout
  page={suspensionPage}
  hero={suspensionHero}
  headingId="suspension-h1"
  bodyClass="oc-services-page oc-suspension-page"
  certificates={[{ name: 'Öhlins', src: siteImages.ohlins }]}
  faqs={faqs}
  faqHeadingId="suspension-faq-title"
  defaultService="Suspensiones"
>
  <ServiceWatermarkTrack text="SUSPENSIONES">
    <nav class="oc-services-container oc-suspension-breadcrumb" aria-label="Ruta de navegación">
      <ol>
        <li>
          <a href={base}>Inicio</a>
        </li>
        <li>
          <a href={withBase('reparacion-bicicletas-barcelona/')}>Servicios</a>
        </li>
        <li>
          <span aria-current="page">Suspensiones</span>
        </li>
      </ol>
    </nav>

    <ServiceSymptoms
      headingId="suspension-symptoms-title"
      eyebrow="Señales de tu suspensión"
      title="¿Notas que tu bici"
      accent="pierde control?"
      symptoms={[
        'La horquilla pierde aire o se hunde más de lo habitual',
        'Ves aceite en las barras o el amortiguador',
        'La suspensión rebota de forma irregular',
        'Oyes ruidos o notas holgura al rodar',
      ]}
    />

    <section
      class="oc-services-container oc-services-section oc-suspension-intro"
      aria-labelledby="suspension-intro-title"
    >
      <div>
        <p class="oc-services-eyebrow">Especialista en suspensiones</p>
        <h2 class="oc-services-display" id="suspension-intro-title">
          Cada ajuste.
          <br />
          <span>Se nota en el camino.</span>
        </h2>
      </div>
      <div class="oc-suspension-intro__text">
        <p>
          Una suspensión bien mantenida aporta sensibilidad, apoyo y control. Reviso su estado y te
          explico qué necesita antes de intervenir.
        </p>
        <ul class="oc-suspension-benefits">
          <li>Sensibilidad</li>
          <li>Estabilidad</li>
          <li>Confianza</li>
        </ul>
      </div>
    </section>

    <section
      class="oc-services-container oc-services-section oc-suspension-specialties"
      id="cuidado-suspension"
      aria-labelledby="suspension-specialties-title"
    >
      <p class="oc-services-eyebrow">Cuidado para cada componente</p>
      <h2 class="oc-services-display" id="suspension-specialties-title">
        Tu suspensión.
        <br />
        <span>Al detalle.</span>
      </h2>
      <div class="oc-suspension-grid">
        {specialties.map((item, index) => (
          <article class="oc-suspension-card">
            <Image
              src={item.image}
              alt={item.alt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 700px) 92vw, (max-width: 1024px) 46vw, 560px"
              format="webp"
              quality={90}
              loading="lazy"
              decoding="async"
            />
            <div class="oc-suspension-card__body">
              <h3>
                <a
                  href="#reserva"
                  data-booking-service={item.service}
                  data-booking-detail={`Suspensiones · ${item.title}`}
                >
                  <span class="oc-suspension-card__number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  {item.title}
                  <span class="oc-suspension-card__arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="oc-suspension-cta">
        <a class="button" href="#reserva" data-booking-service="Suspensiones">
          Consulta tu suspensión <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <Workflow
      headingId="suspension-workflow-title"
      line1="Un proceso técnico."
      steps={workflowSteps}
    />
  </ServiceWatermarkTrack>

  <section
    class="oc-services-container oc-services-section oc-suspension-brands"
    aria-labelledby="suspension-brands-title"
  >
      <p class="oc-services-eyebrow">Principales marcas</p>
      <div class="oc-suspension-brands__heading">
        <h2 class="oc-services-display" id="suspension-brands-title">
          Experiencia
          <br />
          <span>con tu suspensión.</span>
        </h2>
        <p>Consulta el servicio disponible para tu marca y modelo.</p>
      </div>
      <ul class="oc-suspension-brands__list" role="list">
        {brands.map((brand) => (
          <li>
            <img
              class:list={['oc-suspension-brand', { 'oc-suspension-brand--white': brand.white }]}
              src={brand.image}
              alt={brand.name}
              width={brand.white ? 2144 : 500}
              height={brand.white ? 736 : 500}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
  </section>
</ServiceLayout>
