---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import { withBase } from '../lib/paths.js';
import { image } from '../data/images.ts';
import Workflow from '../components/Workflow.astro';
import { servicesPage, serviceHero, serviceFaqs, workflowSteps } from '../data/services.ts';
---

<ServiceLayout
  page={servicesPage}
  hero={serviceHero}
  headingId="services-h1"
  faqs={serviceFaqs}
  faqId="preguntas-servicios"
  faqHeadingId="services-faq-title"
  faqClass="oc-services-section oc-services-container oc-services-faq"
>
  <!-- HERO: ocupa como mínimo el viewport completo, también en móvil. -->

  <!-- Credenciales: recorte de los márgenes transparentes de los PNG. -->

  <!-- SECCIÓN NUEVA: revisiones, sin carrusel ni precios inventados. -->
  <section
    class="oc-services-section oc-services-container"
    id="revisiones"
    aria-labelledby="revisiones-title"
  >
    <h2 class="oc-services-eyebrow" id="revisiones-title">
      Revisiones y mantenimiento
    </h2>
    <p class="oc-services-display">
      Cuidado a la altura
      <br />
      <span>de tu bicicleta.</span>
    </p>
    <p class="oc-services-lead">
      Revisiones adaptadas a las exigencias de tu bicicleta y a tu forma de rodar.
    </p>
    <div class="oc-revision-grid">
      <article class="oc-revision-card">
        <img
          src={image('servicio-suspensiones.webp')}
          alt="Detalle de una horquilla de suspensión"
          width="800"
          height="550"
          loading="lazy"
        />
        <div class="oc-revision-card__content">
          <h3>
            <span>01 /</span> Revisión básica
          </h3>
          <ul>
            <li>Ajuste general</li>
            <li>Revisión de seguridad</li>
            <li>Limpieza básica</li>
          </ul>
          <a
            href="#reserva"
            data-booking-service="Revisiones"
            data-booking-detail="Revisión básica"
          >
            Consultar revisión <span aria-hidden="true">↗</span>
            <span class="sr-only"> básica</span>
          </a>
        </div>
      </article>
      <article class="oc-revision-card">
        <img
          src={image('servicio-transmision.webp')}
          alt="Detalle del cassette y la transmisión"
          width="800"
          height="550"
          loading="lazy"
        />
        <div class="oc-revision-card__content">
          <h3>
            <span>02 /</span> Revisión intermedia
          </h3>
          <ul>
            <li>Revisión completa</li>
            <li>Ajustes y lubricación</li>
            <li>Informe de estado</li>
          </ul>
          <a
            href="#reserva"
            data-booking-service="Revisiones"
            data-booking-detail="Revisión intermedia"
          >
            Consultar revisión <span aria-hidden="true">↗</span>
            <span class="sr-only"> intermedia</span>
          </a>
        </div>
      </article>
      <article class="oc-revision-card">
        <img
          src={image('servicio-frenos.webp')}
          alt="Detalle de un freno de disco"
          width="800"
          height="550"
          loading="lazy"
        />
        <div class="oc-revision-card__content">
          <h3>
            <span>03 /</span> Revisión completa
          </h3>
          <ul>
            <li>Desmontaje y limpieza</li>
            <li>Revisión de componentes</li>
            <li>Puesta a punto avanzada</li>
          </ul>
          <a
            href="#reserva"
            data-booking-service="Revisiones"
            data-booking-detail="Revisión completa"
          >
            Consultar revisión <span aria-hidden="true">↗</span>
            <span class="sr-only"> completa</span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- SECCIÓN NUEVA: los ocho servicios permanecen visibles. -->
  <section
    class="oc-services-section oc-services-container"
    id="servicios-especializados"
    aria-labelledby="specialist-title"
  >
    <h2 class="oc-services-eyebrow" id="specialist-title">
      Servicio técnico especializado
    </h2>
    <p class="oc-services-display">
      Precisión en
      <br />
      <span>cada componente.</span>
    </p>
    <p class="oc-services-lead">
      Trabajo personalmente cada bicicleta, con herramientas específicas y criterio técnico.
    </p>
    <ul class="oc-specialist-grid">
      <li>
        <a href={withBase('suspension-bicicleta/')}>
          <img
            src={image('servicio-suspensiones.webp')}
            alt=""
            width="400"
            height="240"
            loading="lazy"
          />
          <div>
            <h3>Suspensiones</h3>
            <p>Revisión, mantenimiento y configuración.</p>
          </div>
          <span class="oc-services-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
      <li>
        <a href="#reserva" data-booking-service="Frenos">
          <img src={image('servicio-frenos.webp')} alt="" width="400" height="240" loading="lazy" />
          <div>
            <h3>Frenos e hidráulica</h3>
            <p>Ajuste, purgado y sustitución de componentes.</p>
          </div>
          <span class="oc-services-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
      <li>
        <a href="#reserva" data-booking-service="Transmisión">
          <img
            src={image('servicio-transmision.webp')}
            alt=""
            width="400"
            height="240"
            loading="lazy"
          />
          <div>
            <h3>Transmisión</h3>
            <p>Revisión, ajuste y sustitución de componentes.</p>
          </div>
          <span class="oc-services-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
      <li>
        <a href="#reserva" data-booking-service="Ruedas">
          <img src={image('servicio-ruedas.webp')} alt="" width="400" height="240" loading="lazy" />
          <div>
            <h3>Ruedas</h3>
            <p>Centrado, tensión y mantenimiento.</p>
          </div>
          <span class="oc-services-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
      <li>
        <a href="#reserva" data-booking-service="Tijas telescópicas">
          <img src={image('servicio-tijas.webp')} alt="" width="400" height="240" loading="lazy" />
          <div>
            <h3>Tijas telescópicas</h3>
            <p>Revisión, mantenimiento y ajuste del funcionamiento.</p>
          </div>
          <span class="oc-services-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
      <li>
        <a href="#reserva" data-booking-service="Rodamientos y dirección">
          <img
            src={image('servicio-rodamientos.webp')}
            alt=""
            width="400"
            height="240"
            loading="lazy"
          />
          <div>
            <h3>Rodamientos y dirección</h3>
            <p>Control, limpieza y sustitución.</p>
          </div>
          <span class="oc-services-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
      <li>
        <a href="#reserva" data-booking-service="E-Bike">
          <img src={image('servicio-ebike.webp')} alt="" width="400" height="240" loading="lazy" />
          <div>
            <h3>E-Bike</h3>
            <p>Diagnóstico y mantenimiento de e-bikes de alta gama.</p>
          </div>
          <span class="oc-services-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
      <li>
        <a href="#reserva" data-booking-service="Setup y ajustes">
          <img src={image('servicio-setup.webp')} alt="" width="400" height="240" loading="lazy" />
          <div>
            <h3>Puesta a punto y ajustes</h3>
            <p>Ajustes de posición y funcionamiento según tu uso.</p>
          </div>
          <span class="oc-services-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
    </ul>
  </section>

  <!-- SECCIÓN NUEVA: proceso completo, accesible sin JavaScript. -->
  <Workflow
    headingId="workflow-title"
    line1="Cada intervención."
    steps={workflowSteps}
    displayHeading={false}
    sectionClass="oc-services-section oc-services-container oc-workflow"
  />

  <!-- Componente existente, sin duplicar su contenido. -->

  <!-- SECCIÓN NUEVA: preguntas exclusivas de Servicios. -->

  <!-- Conserva el título y los campos del formulario de la HOME. -->
</ServiceLayout>
